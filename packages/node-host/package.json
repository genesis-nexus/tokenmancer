{
  "name": "@cte/node-host",
  "version": "0.1.0",
  "private": true,
  "description": "Node-only host: VS Code workspace/log discovery, jsonl tailer, on-disk instruction measurement.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@cte/core": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js"
  }
}
